generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  classType     String
  preferredDate String?
  participants  Int      @default(1)
  message       String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}
